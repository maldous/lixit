{
  "cli": {
    "version": "16.12.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "dev"
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview"
    },
    "production": {
      "distribution": "store",
      "autoIncrement": true,
      "channel": "prod"
    }
  },
  "submit": {
    "production": {}
  },
  "update": {
    "dev": {
      "channel": "dev"
    },
    "preview": {
      "channel": "preview"
    },
    "production": {
      "channel": "prod"
    }
  }
}
