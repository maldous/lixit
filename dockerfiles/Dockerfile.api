ARG NODE_MAJOR=24
ARG REGISTRY_CACHE=localhost:5001/lixit-cache

FROM ${REGISTRY_CACHE}/base-deps:${NODE_MAJOR} AS deps
ARG NODE_MAJOR

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./

RUN mkdir -p packages/core packages/ui-kit services/ingestion-api
COPY packages/core/package.json ./packages/core/
COPY packages/ui-kit/package.json ./packages/ui-kit/
COPY services/ingestion-api/package.json ./services/ingestion-api/

RUN --mount=type=cache,id=pnpm-store-${NODE_MAJOR}-full,target=/root/.pnpm-store,sharing=locked \
    pnpm install --prefer-offline

FROM deps AS build
COPY packages/core packages/core/
COPY services/ingestion-api services/ingestion-api/
RUN pnpm --filter @lixit/ingestion-api run build

FROM build AS deploy
RUN pnpm deploy --filter @lixit/ingestion-api --legacy --prod  /app/deploy

FROM node:${NODE_MAJOR}-alpine AS runtime
RUN addgroup -S nodejs && adduser -S nestjs -G nodejs -u1001
WORKDIR /app
ENV NODE_ENV=production

COPY --from=deploy /app/deploy ./

USER nestjs
EXPOSE 3000
CMD ["node", "dist/main.js"]
