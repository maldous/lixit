# syntax=docker/dockerfile:1.4
ARG NODE_MAJOR=24
FROM lixit/base-deps:${NODE_MAJOR} AS build
ENV PNPM_STORE_PATH=/root/.pnpm-store
WORKDIR /repo
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY packages/core packages/core/
COPY services/ingestion-api services/ingestion-api/
RUN --mount=type=cache,id=pnpm-cache,target=$PNPM_STORE_PATH pnpm install --frozen-lockfile
RUN pnpm --filter @lixit/ingestion-api run build
RUN pnpm prune --prod
FROM node:${NODE_MAJOR}-alpine
RUN addgroup -S nodejs && adduser -S nestjs -G nodejs -u1001
WORKDIR /app
ENV NODE_ENV=production
COPY --from=build /repo/services/ingestion-api/dist ./dist
COPY --from=build /repo/services/ingestion-api/package.json ./
COPY --from=build /repo/node_modules ./node_modules
USER nestjs
EXPOSE 3000
CMD ["node","dist/main.js"]

