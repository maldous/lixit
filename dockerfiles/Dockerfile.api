# syntax=docker/dockerfile:1.4
ARG NODE_MAJOR=24

# Deps stage - all dependencies for building
FROM lixit/base-deps:${NODE_MAJOR} AS deps

# Copy only package manifests
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
# Copy root-level config files if present
COPY .npmrc* ./
RUN mkdir -p services/ingestion-api packages/core
COPY services/ingestion-api/package.json ./services/ingestion-api/
COPY packages/core/package.json ./packages/core/

# Install all dependencies with cache mount
RUN --mount=type=cache,id=pnpm-store-${NODE_MAJOR}-ingestion-api,target=/root/.pnpm-store,sharing=locked \
    pnpm install --filter @lixit/ingestion-api --prefer-offline

# Build stage
FROM deps AS build
COPY packages/core packages/core/
COPY services/ingestion-api services/ingestion-api/
RUN pnpm --filter @lixit/ingestion-api run build

# Production deps stage
FROM deps AS prod-deps
RUN pnpm prune --filter @lixit/ingestion-api --prod

# Runtime stage
FROM node:${NODE_MAJOR}-alpine AS runtime
RUN addgroup -S nodejs && adduser -S nestjs -G nodejs -u1001
WORKDIR /app
ENV NODE_ENV=production

COPY --from=build /app/services/ingestion-api/dist ./dist
COPY --from=build /app/services/ingestion-api/package.json ./
COPY --from=prod-deps /app/node_modules ./node_modules

USER nestjs
EXPOSE 3000
CMD ["node", "dist/main.js"]
