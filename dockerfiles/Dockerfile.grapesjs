ARG NODE_MAJOR=24

FROM lixit/base-deps:${NODE_MAJOR} AS deps

ARG NODE_MAJOR
FROM node:${NODE_MAJOR}-alpine AS build
WORKDIR /repo
COPY . .
COPY --from=deps /repo/node_modules ./node_modules
RUN npm run build --workspace=@lixit/grapesjs-server

ARG NODE_MAJOR
FROM node:${NODE_MAJOR}-alpine
WORKDIR /app
ENV NODE_ENV=production
RUN addgroup -S nodejs && adduser -S grapesjs -G nodejs -u 1001
COPY --from=build /repo/services/grapesjs-server/dist ./dist
COPY --from=build /repo/services/grapesjs-server/package.json ./
COPY --from=deps  /repo/node_modules ./node_modules

RUN npm prune --omit=dev && npm cache clean --force

USER grapesjs
EXPOSE 3000
CMD ["node","dist/main.js"]
