# syntax=docker/dockerfile:1.6
FROM lixit/base-deps:18 AS deps

FROM node:18-alpine AS build
WORKDIR /repo
COPY . .
COPY --from=deps /repo/node_modules ./node_modules
RUN npm run build --workspace=@lixit/grapesjs-server

FROM node:18-alpine
WORKDIR /app
ENV NODE_ENV=production
RUN addgroup -S nodejs && adduser -S grapesjs -G nodejs -u 1001
COPY --from=build /repo/services/grapesjs-server/dist ./dist
COPY --from=build /repo/services/grapesjs-server/package.json ./
COPY --from=deps  /repo/node_modules ./node_modules
USER grapesjs
EXPOSE 3000
CMD ["node","dist/main.js"]
