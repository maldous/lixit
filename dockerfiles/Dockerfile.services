ARG NODE_MAJOR=24
ARG REGISTRY_CACHE=localhost:5001/lixit-cache
ARG SERVICE

FROM ${REGISTRY_CACHE}/base-deps:${NODE_MAJOR} AS deps
ARG NODE_MAJOR
ARG SERVICE

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./

RUN mkdir -p packages/core packages/ui-kit services/${SERVICE}
COPY packages/core/package.json ./packages/core/
COPY packages/ui-kit/package.json ./packages/ui-kit/
COPY services/${SERVICE}/package.json ./services/${SERVICE}/

RUN --mount=type=cache,id=pnpm-store-${NODE_MAJOR}-full,target=/root/.pnpm-store,sharing=locked \
    pnpm install --prefer-offline

FROM deps AS build
ARG SERVICE
COPY packages/core packages/core/
COPY services/${SERVICE} services/${SERVICE}/
RUN pnpm --filter @lixit/${SERVICE} run build

FROM build AS deploy
ARG SERVICE
RUN pnpm deploy --filter @lixit/${SERVICE} --legacy --prod /app/deploy

FROM node:${NODE_MAJOR}-alpine AS runtime
ARG SERVICE
RUN addgroup -S nodejs && adduser -S svc -G nodejs -u1001
WORKDIR /app
ENV NODE_ENV=production

COPY --from=deploy /app/deploy ./

USER svc
EXPOSE 3000
CMD ["node", "dist/main.js"]
