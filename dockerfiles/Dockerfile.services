# syntax=docker/dockerfile:1.6
# Build stage ────────────────────────────────────────────────────────────────
FROM node:18-alpine AS build
WORKDIR /repo

# ARG lets the same Dockerfile build any service
ARG SERVICE
ENV SERVICE=${SERVICE:-doc-renderer}

# bring in sources
COPY package.json package-lock.json* ./
COPY apps      ./apps
COPY packages  ./packages
COPY services  ./services

# install root + workspace deps
RUN npm ci --workspaces --include-workspace-root

# build the requested workspace
RUN npm run build --workspace=@lixit/${SERVICE}

# Runtime stage ──────────────────────────────────────────────────────────────
FROM node:18-alpine
WORKDIR /app
ENV NODE_ENV=production

RUN addgroup -S nodejs && adduser -S svc -G nodejs -u 1001

# copy only what we need
COPY --from=build /repo/services/${SERVICE}/dist ./dist
COPY --from=build /repo/services/${SERVICE}/package.json ./
COPY --from=build /repo/node_modules ./node_modules

USER svc
EXPOSE 3000
CMD ["node","dist/main.js"]

