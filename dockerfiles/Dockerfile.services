# syntax=docker/dockerfile:1.6
FROM lixit/base-deps:18 AS deps

FROM node:18-alpine AS build
WORKDIR /repo
COPY . .
COPY --from=deps /repo/node_modules ./node_modules
RUN npm run build

FROM node:18-alpine
WORKDIR /app
ENV NODE_ENV=production
RUN addgroup -S nodejs && adduser -S svc -G nodejs -u 1001
COPY --from=build /repo/services ./services
COPY --from=build /repo/packages ./packages
COPY --from=deps  /repo/node_modules ./node_modules
USER svc
EXPOSE 3000
CMD ["node","services/doc-renderer/dist/main.js"]
