# syntax=docker/dockerfile:1.4
ARG NODE_MAJOR=24
ARG REGISTRY_CACHE=localhost:5001/lixit-cache
ARG SERVICE

# Deps stage - installs all dependencies (including dev) for building
FROM ${REGISTRY_CACHE}/base-deps:${NODE_MAJOR} AS deps
ARG NODE_MAJOR
ARG SERVICE

# Copy only package manifests for dependency resolution
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
# Copy root-level config files if present
COPY .npmrc* ./

# Copy workspace libs this service depends on
RUN mkdir -p services/${SERVICE} packages/core
COPY services/${SERVICE}/package.json ./services/${SERVICE}/
COPY packages/core/package.json ./packages/core/

# Install all dependencies (including dev) with cache mount
RUN --mount=type=cache,id=pnpm-store-${NODE_MAJOR}-${SERVICE},target=/root/.pnpm-store,sharing=locked \
    pnpm install --filter @lixit/${SERVICE} --prefer-offline

# Build stage - copies source and builds
FROM deps AS build
ARG SERVICE
COPY packages/core packages/core/
COPY services/${SERVICE} services/${SERVICE}/
RUN pnpm --filter @lixit/${SERVICE} run build

# Production deps stage - prune dev dependencies
FROM deps AS prod-deps
ARG SERVICE
RUN pnpm install --filter @lixit/${SERVICE} --prod --prefer-offline

# Runtime stage - minimal final image
FROM node:${NODE_MAJOR}-alpine AS runtime
ARG SERVICE
RUN addgroup -S nodejs && adduser -S svc -G nodejs -u1001
WORKDIR /app
ENV NODE_ENV=production

# Copy build output and production node_modules
COPY --from=build /app/services/${SERVICE}/dist ./dist
COPY --from=build /app/services/${SERVICE}/package.json ./
COPY --from=prod-deps /app/node_modules ./node_modules

USER svc
EXPOSE 3000
CMD ["node", "dist/main.js"]
