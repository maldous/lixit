# syntax=docker/dockerfile:1.4
ARG NODE_MAJOR=24

FROM lixit/base-deps:${NODE_MAJOR} AS deps

FROM node:${NODE_MAJOR}-alpine
WORKDIR /app

ENV STORYBOOK_CACHE_DIR=/tmp/.storybook-cache

COPY --from=deps /repo/node_modules ./node_modules
COPY --from=deps /repo/package*.json ./
COPY --from=deps /repo/packages        ./packages
COPY --from=deps /repo/apps/web        ./apps/web

RUN --mount=type=cache,id=storybook-cache,target=/tmp/.storybook-cache \
    npm install -g @storybook/cli

EXPOSE 6006
CMD ["npm","run","storybook","--workspace=@lixit/web"]

