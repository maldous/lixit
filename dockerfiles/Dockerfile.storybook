# syntax=docker/dockerfile:1.4
ARG NODE_MAJOR=24
FROM lixit/base-deps:${NODE_MAJOR} AS build
ENV PNPM_STORE_PATH=/root/.pnpm-store
WORKDIR /repo
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY packages/ui-kit packages/ui-kit/
RUN --mount=type=cache,id=pnpm-cache,target=$PNPM_STORE_PATH pnpm install --frozen-lockfile
RUN pnpm --filter @lixit/ui-kit run build-storybook
FROM node:${NODE_MAJOR}-alpine
RUN addgroup -S nodejs && adduser -S storybook -G nodejs -u1001
WORKDIR /app
COPY --from=build /repo/packages/ui-kit/storybook-static ./storybook-static
USER storybook
EXPOSE 6006
CMD ["npx","serve","-s","storybook-static","-l","6006"]

