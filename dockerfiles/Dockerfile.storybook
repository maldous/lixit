# syntax=docker/dockerfile:1.4
ARG NODE_MAJOR=24

FROM node:${NODE_MAJOR}-alpine AS build
WORKDIR /repo
COPY package.json package-lock.json* ./
COPY apps/web/package.json apps/web/
RUN --mount=type=cache,id=npm-cache,target=/root/.npm \
    npm ci --workspaces --include-workspace-root
COPY apps/web ./apps/web
COPY packages ./packages
RUN --mount=type=cache,id=storybook-cache,target=/root/.cache/storybook \
    npm install -g @storybook/cli

FROM node:${NODE_MAJOR}-alpine
WORKDIR /app

# root manifest so npm has a project context
COPY --from=build /repo/package*.json ./

# runtime deps + global CLI
COPY --from=build /repo/node_modules ./node_modules
COPY --from=build /usr/local/bin /usr/local/bin
COPY --from=build /usr/local/lib/node_modules/@storybook /usr/local/lib/node_modules/@storybook

# workspace source
COPY --from=build /repo/apps/web ./apps/web

EXPOSE 6006
CMD ["npm","run","storybook","--workspace=@lixit/web"]
