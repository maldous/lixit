# Example SOPS-encrypted secrets file
# Encrypt with: sops -e -i secrets.yaml
# Decrypt with: sops -d secrets.yaml

# Database credentials
database:
  superuser_password: "CHANGE_ME_STRONG_PASSWORD"
  user_password: "CHANGE_ME_USER_PASSWORD"

# Keycloak admin credentials
keycloak:
  admin_password: "CHANGE_ME_ADMIN_PASSWORD"
  
# Redis credentials
redis:
  password: "CHANGE_ME_REDIS_PASSWORD"

# MinIO credentials
minio:
  access_key: "CHANGE_ME_ACCESS_KEY"
  secret_key: "CHANGE_ME_SECRET_KEY"

# JWT secrets
jwt:
  secret: "CHANGE_ME_JWT_SECRET"

# Age public key for SOPS encryption
# Generate with: age-keygen -o age-key.txt
# Public key: age1xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx