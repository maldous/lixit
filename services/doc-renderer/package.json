{
  "name": "@lixit/doc-renderer",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc",
    "build:prod": "tsc",
    "start": "node dist/main.js",
    "dev": "ts-node src/main.ts",
    "lint": "eslint src",
    "test": "jest",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "dependencies": {
    "@lixit/core": "file:../../packages/core",
    "bull": "^4.16.5",
    "exceljs": "^4.4.0",
    "pdf-lib": "^1.17.1",
    "puppeteer": "^24.10.2",
    "redis": "^5.5.6"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.3",
    "@typescript-eslint/eslint-plugin": "^8.35.0",
    "@typescript-eslint/parser": "^8.35.0",
    "eslint": "^9.29.0",
    "jest": "^30.0.2",
    "prettier": "^3.6.0",
    "ts-jest": "^29.4.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  }
}
